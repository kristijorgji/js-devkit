{
  "name": "@kristijorgji/eslint-config-typescript",
  "version": "1.1.0",
  "description": "Flat ESLint TypeScript config factory built on @kristijorgji/eslint-plugin",
  "type": "module",
  "license": "MIT",
  "author": "kristijorgji",
  "engines": {
    "node": ">=22.16.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kristijorgji/js-devkit.git",
    "directory": "packages/eslint-config-typescript"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./base": {
      "types": "./dist/base.d.ts",
      "import": "./dist/base.js"
    },
    "./typed": {
      "types": "./dist/typed.d.ts",
      "import": "./dist/typed.js"
    },
    "./ignores": {
      "types": "./dist/ignores.d.ts",
      "import": "./dist/ignores.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "eslint": "^9 || ^10",
    "prettier": "^3",
    "typescript": "^5 || ^6"
  },
  "dependencies": {
    "@eslint/js": "^9",
    "@kristijorgji/eslint-plugin": "workspace:^",
    "eslint-config-prettier": "^10",
    "eslint-plugin-import-x": "^4",
    "eslint-plugin-prettier": "^5",
    "globals": "^17",
    "typescript-eslint": "^8"
  },
  "devDependencies": {
    "@types/node": "^26",
    "eslint": "^10",
    "prettier": "^3",
    "typescript": "^5",
    "vitest": "^4"
  }
}
