{
  "name": "@kristijorgji/openapi-utils",
  "version": "0.1.0",
  "description": "Reusable OpenAPI helpers. First module merges versioned documents into one spec.",
  "type": "module",
  "license": "MIT",
  "author": "kristijorgji",
  "engines": {
    "node": ">=22.16.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kristijorgji/js-devkit.git",
    "directory": "packages/openapi-utils"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26",
    "typescript": "^5",
    "vitest": "^5"
  }
