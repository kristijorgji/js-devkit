{
  "name": "@kristijorgji/quality-gates",
  "version": "0.1.0",
  "description": "Configurable pre-commit and working-tree quality gate runner for JS monorepos",
  "type": "module",
  "license": "MIT",
  "author": "kristijorgji",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "kj-quality-gates": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kristijorgji/js-devkit.git",
    "directory": "packages/quality-gates"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "default": "./dist/config/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kristijorgji/cli-kit": "workspace:^",
    "commander": "^15",
    "jiti": "^2"
  },
  "devDependencies": {
    "@types/node": "^26",
    "typescript": "^5",
    "vitest": "^5"
  }
}
