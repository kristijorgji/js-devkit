{
  "name": "@kristijorgji/eslint-config-react-typescript",
  "version": "1.0.0",
  "description": "Flat ESLint React TypeScript config factory (vite | next) on @kristijorgji/eslint-config-typescript",
  "type": "module",
  "license": "MIT",
  "author": "kristijorgji",
  "engines": {
    "node": ">=22.16.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kristijorgji/js-devkit.git",
    "directory": "packages/eslint-config-react-typescript"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@next/eslint-plugin-next": "^15 || ^16",
    "eslint": "^9 || ^10",
    "eslint-plugin-jsx-a11y": "^6",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-dom": "^1 || ^2",
    "eslint-plugin-react-x": "^1 || ^2",
    "eslint-plugin-storybook": "^0 || ^9 || ^10",
    "prettier": "^3",
    "typescript": "^5 || ^6"
  },
  "peerDependenciesMeta": {
    "@next/eslint-plugin-next": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "eslint-plugin-react": {
      "optional": true
    },
    "eslint-plugin-react-dom": {
      "optional": true
    },
    "eslint-plugin-react-x": {
      "optional": true
    },
    "eslint-plugin-storybook": {
      "optional": true
    }
  },
  "dependencies": {
    "@kristijorgji/eslint-config-typescript": "workspace:^",
    "@kristijorgji/eslint-plugin": "workspace:^",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.4",
    "globals": "^16"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15",
    "@types/node": "^22",
    "eslint": "^9",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-dom": "^5",
    "eslint-plugin-react-x": "^1",
    "eslint-plugin-storybook": "^9",
    "prettier": "^3",
    "typescript": "^5",
    "vitest": "^3"
  }
}
