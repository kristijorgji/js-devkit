{
  "name": "@kristijorgji/seo-audit",
  "version": "0.1.0",
  "description": "Sitemap, robots.txt and rendered-page SEO audit CLI with HTML report (kj-seo)",
  "type": "module",
  "license": "MIT",
  "author": "kristijorgji",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "kj-seo": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kristijorgji/js-devkit.git",
    "directory": "packages/seo-audit"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kristijorgji/cli-kit": "workspace:^",
    "cheerio": "^1.0.0",
    "commander": "^15.1.0",
    "fast-xml-parser": "^5.11.2",
    "jiti": "^2",
    "robots-parser": "^3.1.1",
    "xmllint-wasm": "^5.3.0"
  },
  "peerDependencies": {
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.5.0"
  },
  "peerDependenciesMeta": {
    "chrome-launcher": { "optional": true },
    "lighthouse": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^26",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.5.0",
    "typescript": "^5",
    "vitest": "^5"
  }
}
