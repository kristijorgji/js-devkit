{
  "name": "@kristijorgji/docs-viewer",
  "version": "0.1.0",
  "description": "Shared HTML table viewer shell for generated docs (title, styles, data injection)",
  "type": "module",
  "license": "MIT",
  "author": "kristijorgji",
  "engines": {
    "node": ">=22.16.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kristijorgji/js-devkit.git",
    "directory": "packages/docs-viewer"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26",
    "typescript": "^5",
    "vitest": "^4"
  }
}
