{
  "name": "js-devkit",
  "private": true,
  "version": "0.0.0",
  "description": "Shared ESLint rules and code-analysis tooling for TypeScript/JavaScript projects",
  "license": "MIT",
  "author": "kristijorgji",
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "ci:version": "changeset version && pnpm install --lockfile-only",
    "ci:publish": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.29.4",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
